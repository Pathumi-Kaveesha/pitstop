# Template for .env - copy this to .env and fill in real values.
# The real .env is gitignored, same as backend/Config.toml and
# webapp/public/config.js.

# Embeddings (turns text into vectors) - Vertex AI.
VERTEX_PROJECT_ID=
# Optional - defaults to "global".
VERTEX_LOCATION=
# The service account key file's JSON on one line - if unset, the default Google credentials are used.
VERTEX_SERVICE_ACCOUNT_JSON=

# Answer generation - Anthropic console.
ANTHROPIC_API_KEY=
# Optional - only set this if routing through a custom host/proxy instead of
# Anthropic's own API.
ANTHROPIC_BASE_URL=
# Optional - defaults to claude-sonnet-5 if unset.
CLAUDE_GENERATION_MODEL=

# The Drive Service, which reads Google Drive, Docs, Sheets and Slides for this service.
# Locally, e.g. http://localhost:9094 with the Drive Service running in DEV_MODE.
DRIVE_SERVICE_URL=
# On Choreo, the connection's token endpoint and client credentials.
DRIVE_SERVICE_TOKEN_URL=
DRIVE_SERVICE_CLIENT_ID=
DRIVE_SERVICE_CLIENT_SECRET=
# Locally only, instead of the three above: the Drive Service's DEV_AUTH_TOKEN.
DRIVE_SERVICE_AUTH_TOKEN=

# Vector store - a PostgreSQL database with the pgvector extension enabled.
# Format: host=HOST port=PORT dbname=DBNAME user=USERNAME password=PASSWORD
POSTGRES_DSN=
