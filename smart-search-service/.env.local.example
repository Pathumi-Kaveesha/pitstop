# Template for .env - copy this to .env and fill in real values.
# The real .env is gitignored, same as backend/Config.toml and
# webapp/public/config.js.

# Embeddings (turns text into vectors) - Google AI Studio.
GEMINI_API_KEY=

# Answer generation - Anthropic console.
ANTHROPIC_API_KEY=

# Drive access, obtained once via Google's OAuth Playground.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Vector store.
PINECONE_API_KEY=
PINECONE_SERVICE_URL=
